],"properties":{"Node name for S&R":"UNETLoader"},"widgets_values":["minimax_h3_ref2va_pruned_bf16.safetensors","default"],"widgets_values_named":{"unet_name":"minimax_h3_ref2va_pruned_bf16.safetensors","weight_dtype":"default"}},{"id":145,"type":"LoraLoaderModelOnly","pos":[-2715.004152318566,4385.300589572625],"size":[560,100],"flags":{},"order":15,"mode":0,"inputs":[{"localized_name":"模型","name":"model","type":"MODEL","link":274},{"localized_name":"LoRA名称","name":"lora_name","type":"COMBO","widget":{"name":"lora_name"},"link":null},{"localized_name":"模型强度","name":"strength_model","type":"FLOAT","widget":{"name":"strength_model"},"link":null}],"outputs":[{"localized_name":"模型","name":"MODEL","type":"MODEL","links":[271]}],"properties":{"Node name for S&R":"LoraLoaderModelOnly"},"widgets_values":["minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors",1],"widgets_values_named":{"lora_name":"minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors","strength_model":1}},{"id":146,"type":"PrimitiveBoolean","pos":[-2107.4962465876606,4414.577355565936],"size":[280,80],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"值","name":"value","type":"BOOLEAN","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"布尔","name":"BOOLEAN","type":"BOOLEAN","links":[280,288]}],"title":"Boolean (Enable Lightning LoRA)","properties":{"Node name for S&R":"PrimitiveBoolean"},"widgets_values":[false],"widgets_values_named":{"value":false}},{"id":141,"type":"ComfySwitchNode","pos":[-2109.3696977736126,4231.958162466933],"size":[280,140],"flags":{},"order":18,"mode":0,"inputs":[{"localized_name":"为假时","name":"on_false","shape":7,"type":"MODEL","link":270},{"localized_name":"为真时","name":"on_true","shape":7,"type":"MODEL","link":271},{"localized_name":"切换","name":"switch","type":"BOOLEAN","widget":{"name":"switch"},"link":280}],"outputs":[{"localized_name":"输出","name":"output","type":"MODEL","links":[272,302]}],"title":"If/Else Switch (model)","properties":{"Nod